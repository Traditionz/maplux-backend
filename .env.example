APP_NAME=Maplux

CLIENT_ORIGIN=http://localhost:8000

API_PREFIX=/auth

DATABASE_URL=sqlite:///./Maplux.sqlite

# Replace these with long, random values before running in any shared environment.
ACTIVATE_SECRET_KEY=change-me-activate-secret
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

EMAIL_USERNAME=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_PORT=587
EMAIL_SERVER=sandbox.smtp.mailtrap.io
EMAIL_FROM=maplux.test@example.com
EMAIL_STARTTLS=true
EMAIL_SSL_TLS=false

TESTING=false
